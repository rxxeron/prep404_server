# ==============================================================================
# Prep404 Core Server Environment Configuration
# ==============================================================================

# Server Network Config
PORT=4040
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated browser origins allowed to call the API (admin, landing, web app).
# Localhost origins are always allowed when NODE_ENV is not production.
# Number of reverse-proxy hops in front of the API (leave unset when none).
# TRUST_PROXY=1

CORS_ALLOWED_ORIGINS=https://admin.prep404.com,https://prep404.com

# PostgreSQL Connection String & High-Concurrency Pool Config
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
# In production with 5k-10k concurrent users, connect through PgBouncer (e.g. port 6543 on Supabase)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prep404
DATABASE_POOL_MAX=25
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=15000
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Set to 'true' or provide DATABASE_SSL_CA for strict SSL certificate verification
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SSL_CA=

# Supabase Auth token verification for authenticated mobile API requests
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only key for Supabase Auth Admin account deletion. Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=

# Redis 7.2 Connection URL (Leaderboards, Matchmaking, Session Locks)
# Format: redis://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379
# In production, memory fallback is disabled by default (fails closed) to protect state integrity
# REDIS_ALLOW_MEMORY_FALLBACK=false

# Global Rate Limiting (per IP per minute)
RATE_LIMIT_MAX=600

# JWT secret for staff session tokens. Never reuse an example value.
JWT_SECRET=  # required: generate with `openssl rand -hex 64`

# OTP & SMS Gateway Configuration (Bangladesh)
# Options: 'mock' (for local dev, default OTP 404404) | 'sslwireless' | 'greenweb'
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=PREP404

# Socratic AI Configuration (Optional: for streaming LLM explanations)
OPENAI_API_KEY=your_openai_or_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-flash
